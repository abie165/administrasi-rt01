rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isPengelola() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "pengelola";
    }

    // PDF dapat dibaca warga; hanya pengelola boleh mengunggah atau menghapus.
    match /dokumen_rt/{fileName} {
      allow read: if true;
      allow create, update: if isPengelola()
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if isPengelola();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
